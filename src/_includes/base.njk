<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Jumoo ChangeLog" }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap">
  <link rel="stylesheet" href="{{ '/style.css' | url }}">
</head>
<body>
  <header>
    <div class="site-header-top">
      <a href="{{ '/' | url }}"><img class="site-icon" src="{{ '/jumoo-icon.png' | url }}" alt="Jumoo"></a>
      <nav class="site-nav site-nav-top">
        <a href="{{ '/' | url }}" class="current">changes</a>
        <a href="{{ '/archive/' | url }}">archive</a>
        <a href="{{ '/about/' | url }}">about</a>
      </nav>
    </div>
    {% if search %}
    <input id="search" type="search" placeholder="search..." autocomplete="off">
    {% endif %}
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>// end of log</p>
    <a class="footer-logo" href="https://jumoo.co.uk"><img src="{{ '/jumoo-logo.png' | url }}" alt="Jumoo"></a>
    <nav class="site-nav">
      <a href="{{ '/' | url }}" class="current">changes</a>
      <a href="https://releases.jumoo.co.uk">releases</a>
    </nav>
  </footer>
  <script src="{{ '/search.js' | url }}"></script>
</body>
</html>
