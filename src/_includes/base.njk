<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Jumoo ChangeLog" }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap">
  <link rel="stylesheet" href="{{ '/style.css' | url }}">
</head>
<body>
  <header>
    <nav class="site-nav site-nav-top">
      <a href="https://changes.jumoo.co.uk" class="current">changes</a>
      <a href="https://releases.jumoo.co.uk">releases</a>
      <a href="https://releases.jumoo.co.uk/versions.html">versions</a>
    </nav>
    <div class="header-main">
      <a href="{{ '/' | url }}" class="site-title">~/changelog</a>
      {% if search %}
      <input id="search" type="search" placeholder="search..." autocomplete="off">
      {% endif %}
      <a href="{{ '/about/' | url }}" class="about-link">about</a>
    </div>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>// end of log</p>
    <nav class="site-nav">
      <a href="https://changes.jumoo.co.uk" class="current">changes</a>
      <a href="https://releases.jumoo.co.uk">releases</a>
      <a href="https://releases.jumoo.co.uk/versions.html">versions</a>
    </nav>
  </footer>
  <script src="{{ '/search.js' | url }}"></script>
</body>
</html>
