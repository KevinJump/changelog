<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "changelog" }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap">
  <link rel="stylesheet" href="{{ '/style.css' | url }}">
</head>
<body>
  <header>
    <a href="{{ '/' | url }}" class="site-title">~/changelog</a>
    {% if search %}
    <input id="search" type="search" placeholder="search..." autocomplete="off">
    {% endif %}
    <a href="{{ '/about/' | url }}" class="about-link">about</a>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>// end of log</p>
  </footer>
  <script src="{{ '/search.js' | url }}"></script>
</body>
</html>
